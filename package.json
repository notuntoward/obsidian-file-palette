{
	"name": "file-palette",
	"version": "0.1.0",
	"description": "Palette picker for Obsidian files and folders.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "eslint . --max-warnings=0",
		"build": "npm run lint && tsc --noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"format": "prettier --write \"src/**/*.ts\"",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:browser": "playwright test"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin"
	],
	"author": "Scott Otterson",
	"license": "MIT",
	"overrides": {
		"moment": "2.31.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.64.1",
		"@types/node": "^20.10.0",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"@vitest/coverage-v8": "^4.1.12",
		"@vitest/ui": "^4.0.0",
		"builtin-modules": "^4.0.0",
		"commons": "file:../obsidian-commons",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"fast-check": "^4.10.2",
		"globals": "^17.13.0",
		"jsdom": "^29.0.1",
		"obsidian": "~1.14.4",
		"playwright": "^1.59.1",
		"prettier": "^3.9.10",
		"tslib": "^2.6.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^4.0.0"
	}
}
